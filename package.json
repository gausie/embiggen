{
  "name": "embiggen",
  "version": "1.0.0",
  "description": "Efficient buffing.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "rollup -c rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "watch": "rollup -c rollup.config.ts --configPlugin @rollup/plugin-typescript --watch",
    "install-mafia": "npm run build && create-kolmafia-script --install",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "eslint src --fix --ext .ts && prettier --write .",
    "lint": "eslint src --ext .ts && prettier --check ."
  },
  "dependencies": {
    "kolmafia": "^5.29131.0",
    "libram": "^0.11.23"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^9.39.2",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/babel__core": "^7.20.5",
    "@types/babel__preset-env": "^7.10.0",
    "@types/node": "^25.3.0",
    "create-kolmafia-script": "^0.3.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-libram": "^0.6.0",
    "jiti": "^2.6.1",
    "prettier": "^3.8.1",
    "rollup": "^4.57.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "^4.1.10"
  }
}
